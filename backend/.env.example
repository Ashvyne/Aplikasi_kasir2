# ==============================
# APLIKASI KASIR MODERN - ENV CONFIG
# ==============================

# ---- SERVER CONFIG ----
PORT=3000
NODE_ENV=development

# ---- DATABASE CONFIG ----
# Pilih 'mysql' atau 'sqlite'
DB_DIALECT=mysql

# MySQL Connection (jika menggunakan MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kasir_db
DB_USER=root
DB_PASSWORD=root

# Database Logging (untuk debugging)
DB_LOGGING=false

# ---- JWT CONFIG ----
JWT_SECRET=your_very_secure_secret_key_here_min_32_chars

# ---- UPLOAD CONFIG ----
MAX_FILE_SIZE=5242880  # 5MB in bytes

# ---- CORS CONFIG ----
CORS_ORIGIN=http://localhost:3000

# ---- FORCE SYNC DATABASE ----
# Set to 'true' ONLY untuk rebuild database schema (HATI-HATI: akan drop semua data!)
FORCE_SYNC=false
